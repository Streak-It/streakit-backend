# --- App ---
APP_NAME=streakit
# development | test | staging | production
APP_ENV=development
APP_PORT=8080
# Vercel injects PORT and sends traffic there. PORT overrides APP_PORT.
# debug | info | warn | error
APP_LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=10s
# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-For (empty = none)
APP_TRUSTED_PROXIES=
# Serve Swagger UI at /swagger/index.html (all environments). Set false to hide it.
SWAGGER_ENABLED=true

# --- Database ---
# Full connection string. When set, it overrides the DATABASE_HOST..SSLMODE
# fields below. For Neon, paste the string from Console > Connect as is:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Use the pooled (-pooler) host for the app and the direct host (no -pooler)
# for `make migrate-apply`. If sslmode is missing, require is added for remote hosts.
DATABASE_URL=

# Used only when DATABASE_URL is empty (e.g. local docker compose Postgres)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=streakit_api
# disable | require | verify-ca | verify-full
DATABASE_SSLMODE=disable

DATABASE_MAX_OPEN_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONNECTION_MAX_LIFETIME=5m
DATABASE_CONNECTION_MAX_IDLE_TIME=1m
# Defaults to true outside production, false in production
DATABASE_AUTO_MIGRATE=true

# --- Auth ---
# Required, >= 32 bytes. Generate with: openssl rand -base64 48
# Placeholder-looking values are rejected in staging/production.
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
JWT_ACCESS_TTL=15m
# Go durations only: 168h, not 7d
JWT_REFRESH_TTL=168h
# Defaults to true in staging/production; keep false for local http
COOKIE_SECURE=false
# Empty = host-only cookie
COOKIE_DOMAIN=
# 0 = bcrypt default (10)
BCRYPT_COST=0

# Exact origins allowed to call with credentials (comma-separated).
# Leave empty when the UI is served same-site.
CORS_ORIGINS=

# Login rate limits (fixed window, in-memory per process)
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_EMAIL=5
LOGIN_RATE_LIMIT_WINDOW=15m

# --- Bootstrap ---
# Used only when no active super admin exists. Startup FAILS if none exists
# and these are not all set. Password: 12+ characters, <= 72 bytes.
SUPERADMIN_EMAIL=owner@streakit.local
SUPERADMIN_PASSWORD=change-me-on-first-login
SUPERADMIN_NAME=Owner
