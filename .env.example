# --- App ---
APP_NAME=streakit
# development | test | staging | production
APP_ENV=development
APP_PORT=8080
# debug | info | warn | error
APP_LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=10s
# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-For (empty = none)
APP_TRUSTED_PROXIES=

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=streakit_api
# disable | require | verify-ca | verify-full
DATABASE_SSLMODE=disable

DATABASE_MAX_OPEN_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONNECTION_MAX_LIFETIME=5m
DATABASE_CONNECTION_MAX_IDLE_TIME=1m
# Defaults to true outside production, false in production
DATABASE_AUTO_MIGRATE=true
